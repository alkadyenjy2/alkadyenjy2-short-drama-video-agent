{
  "framework": "fastapi",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/videos",
      "destination": "/api/index.py?__route=/videos"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py?__route=/$1"
    }
  ]
}
